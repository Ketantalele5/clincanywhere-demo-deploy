# Copy to .env for local Docker Compose use. Replace every value marked CHANGE_ME.
# Generate a unique key before deployment:
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=CHANGE_ME_GENERATE_BASE64_32_BYTE_SECRET
JWT_EXPIRATION_SECONDS=900
# Separate 32-byte AES key (base64); store in a secret manager and back it up separately from PostgreSQL.
APP_DATA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_BASE64_32_BYTE_KEY
APP_DATA_ENCRYPTION_KEY_ID=CHANGE_ME_SECRET_MANAGER_VERSION_ID
# Stable, independent HMAC key for consent/opt-out phone fingerprints. Keep this key stable.
APP_PHONE_FINGERPRINT_KEY=CHANGE_ME_GENERATE_BASE64_32_BYTE_KEY

DB_URL=jdbc:postgresql://localhost:5432/carepilot
DB_USERNAME=carepilot
DB_PASSWORD=CHANGE_ME
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_POOL_MAX_SIZE=12
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000

# Internal RabbitMQ broker. Use unique high-entropy credentials in deployment.
RABBITMQ_DEFAULT_USER=clincy-prod-relay
RABBITMQ_DEFAULT_PASS=CHANGE_ME_GENERATE_RANDOM_SECRET

ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=16
ASYNC_QUEUE_CAPACITY=200
WHATSAPP_POOL_SIZE=4
WHATSAPP_QUEUE_CAPACITY=100
SCHEDULER_POOL_SIZE=2
WHATSAPP_OUTBOX_POLL_MS=5000
SSE_HEARTBEAT_MS=15000
SERVER_MAX_THREADS=200
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=70 -XX:+UseG1GC -Xlog:gc*:stdout:time,level,tags

WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLINIC_ID=

# Razorpay test keys for online clinic invoice payments. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ABDM sandbox/live gateway settings (keep disabled until callback signature verification is configured).
ABDM_ENABLED=false
ABDM_MODE=SANDBOX
ABDM_BASE_URL=
ABDM_HIP_ID=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Optional SMS/email adapter: implement this HTTP contract in your chosen provider gateway.
NOTIFICATIONS_PROVIDER_ENABLED=false
NOTIFICATIONS_API_URL=
NOTIFICATIONS_API_TOKEN=
NOTIFICATIONS_SMS_SENDER=
NOTIFICATIONS_EMAIL_SENDER=

# Supply credentials for a managed, clustered STOMP broker in multi-instance production.
STOMP_RELAY_HOST=
STOMP_RELAY_PORT=61613
STOMP_RELAY_LOGIN=
STOMP_RELAY_PASSCODE=

LOG_FORMAT=logstash
LOG_FILE=./logs/clincanywhere.log
OTEL_METRICS_ENABLED=false
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SPLUNK_HEC_HOST=
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_TOKEN=

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_PLATFORM_OWNER_ENABLED=false
BOOTSTRAP_PLATFORM_OWNER_USERNAME=
BOOTSTRAP_PLATFORM_OWNER_PASSWORD=

# Production fails startup until the release gates have an approved, auditable evidence reference.
PRODUCTION_RELEASE_GATES_APPROVED=false
PRODUCTION_RELEASE_EVIDENCE_REF=
